# Video pipeline working directories
inbox/
episodes/
# ...except hermetic test fixtures (HOM-181). The bare `episodes/` rule above
# matches `episodes/` anywhere in the tree, including under `tests/fixtures/`;
# negate it explicitly for the fixtures subtree so committed fixture episodes
# (canonical-portrait-talking-head, future siblings) survive `git add`.
!tests/fixtures/episodes/

# Git worktrees
.worktrees/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Python
*.pyc
__pycache__/
scripts/__pycache__/
tests/__pycache__/
.pytest_cache/
.venv/
*.egg-info/

# Session logs
*.jsonl
# ...except hermetic test fixtures
!tests/fixtures/**/*.jsonl
tmp/
graph/langgraph_dev_v1.log
graph/langgraph_dev.log
graph/.langgraph_api/

# Claude Code runtime artifacts
.claude/scheduled_tasks.lock

# Test-fixture transient files (HOM-181)
# `cache.db.tmp` is the VACUUM INTO landing target the replay harness writes
# to before the atomic rename to `cache.db`; never commit it.
tests/fixtures/episodes/*/cache.db.tmp
# SQLite WAL/SHM sidecars produced if a record-mode run is interrupted before
# the WAL checkpoint + close in `finalize_record_on_miss`.
tests/fixtures/episodes/*/cache.db-wal
tests/fixtures/episodes/*/cache.db-shm
tests/fixtures/episodes/*/cache.db-journal

# HOM-239 (Step D2 of HOM-230 state-first artifacts): fixture-side text
# artifacts under `hyperframes/` and `edit/project.md` are no longer
# committed — `p4_materialize_disk_node` regenerates them from cache.db
# on demand. cache.db is the only source of truth. Keeping these
# gitignored stops a stray `git add` from re-introducing the dual-write
# coupling D2 just removed.
tests/fixtures/episodes/*/hyperframes/index.html
tests/fixtures/episodes/*/hyperframes/captions.html
tests/fixtures/episodes/*/hyperframes/DESIGN.md
tests/fixtures/episodes/*/hyperframes/compositions/
tests/fixtures/episodes/*/hyperframes/.hyperframes/
tests/fixtures/episodes/*/edit/project.md

# HOM-283: fixture-side Windows-npm + runtime gate outputs that should
# never be committed:
# - `node_modules/` + `package-lock.json` from the one-time
#   `npm install` inside the fixture HF dir (CLAUDE.md §"Skill copies"
#   Known Windows blocker).
# - `.waveform-cache/` and `snapshots/` are runtime gate outputs of
#   `npx hyperframes` subprocesses driven by gates against the
#   materialized tmpdir.
tests/fixtures/episodes/*/hyperframes/node_modules/
tests/fixtures/episodes/*/hyperframes/package-lock.json
tests/fixtures/episodes/*/hyperframes/.waveform-cache/
tests/fixtures/episodes/*/hyperframes/snapshots/
